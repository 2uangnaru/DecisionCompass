<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- While ADS_ENABLED != true, strip all AdMob / AdServices manifest entries
         and advertising ID permissions from the release artifact so Play Console
         does not scan a Google test App ID or require AD_ID disclosures. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_TOPICS" tools:node="remove" />

    <application>
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            tools:node="remove" />
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_AD_LOADING"
            tools:node="remove" />
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_INITIALIZATION"
            tools:node="remove" />
        <uses-library
            android:name="android.ext.adservices"
            tools:node="remove" />
        <provider
            android:name="com.google.android.gms.ads.MobileAdsInitProvider"
            tools:node="remove" />
        <activity
            android:name="com.google.android.gms.ads.AdActivity"
            tools:node="remove" />
        <activity
            android:name="com.google.android.gms.ads.OutOfContextTestingActivity"
            tools:node="remove" />
        <activity
            android:name="com.google.android.gms.ads.NotificationHandlerActivity"
            tools:node="remove" />
        <service
            android:name="com.google.android.gms.ads.AdService"
            tools:node="remove" />
    </application>
</manifest>
